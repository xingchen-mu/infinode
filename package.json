{
  "name": "infinode",
  "private": true,
  "version": "0.2.0",
  "main": "desktop/main.mjs",
  "description": "Infinite canvas for ComfyUI: generate, edit and animate images on a board, with every result linked to its inputs.",
  "license": "MIT",
  "keywords": [
    "comfyui",
    "infinite-canvas",
    "ai-image",
    "image-generation",
    "video-generation",
    "workflow",
    "stable-diffusion",
    "ai-agent",
    "mcp"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "concurrently -k -n tunnel,server,web -c gray,cyan,magenta \"node scripts/tunnel.mjs\" \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "dev:noTunnel": "concurrently -k -n server,web -c cyan,magenta \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "tunnel": "node scripts/tunnel.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "desktop:dev": "npm run build && node scripts/ensure-electron.mjs && node scripts/run-electron.mjs desktop/main.mjs",
    "desktop:dir": "npm run build && node scripts/ensure-electron.mjs && electron-builder --dir",
    "desktop:dist": "npm run build && node scripts/ensure-electron.mjs && electron-builder",
    "site:build": "node scripts/build-site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "test:wf": "tsx scripts/test-workflow.ts",
    "build:presets": "tsx scripts/build-presets.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "^4.13.14",
    "image-size": "^2.0.4",
    "lucide-react": "^1.66.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^39.1.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.infinode.app",
    "productName": "Infinode",
    "asar": true,
    "files": [
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "presets/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/tsx/**/*",
      "node_modules/esbuild/**/*",
      "node_modules/@esbuild/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Graphics",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
