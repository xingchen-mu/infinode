# Copy to .env and adjust. Everything here is optional.

# Where ComfyUI is, as seen from this machine. Can also be changed in the app (设置).
COMFY_URL=http://127.0.0.1:8188

# Optional SSH tunnel for a ComfyUI that only listens on a remote server's localhost.
# `npm run dev` keeps `ssh -N -L <COMFY_URL port>:127.0.0.1:<REMOTE_COMFY_PORT> <SSH_HOST>` running.
# Use a host alias from ~/.ssh/config (key-based login). Leave empty for no tunnel.
# One-click model downloads also run on this host (it needs python3), straight into ComfyUI's model folders.
SSH_HOST=
REMOTE_COMFY_PORT=8188

# Backend port, and the address it listens on (0.0.0.0 to use the canvas from other devices on your LAN).
PORT=8787
HOST=127.0.0.1
# Other names the app is opened by (e.g. a reverse proxy domain). localhost and IP addresses always work,
# and *.local names too when HOST shares the app on the LAN.
# ALLOWED_HOSTS=canvas.example.lan

# Canvas assistant (the chat panel): any model pi-ai supports, as provider/model, plus that provider's key.
# You can also configure these fields in Settings; values saved there override this file and take effect immediately.
# AGENT_MODEL=deepseek/deepseek-flash
# DEEPSEEK_API_KEY=
# Or any OpenAI-compatible endpoint (豆包、百炼、Ollama、vLLM…): set its address, the model name there and a key.
# AGENT_BASE_URL=http://127.0.0.1:11434/v1
# AGENT_MODEL=qwen3:32b
# AGENT_API_KEY=
# AGENT_VISION=1        # the model can read images
# AGENT_THINKING=low    # off | low | medium | high, for models that think
# AGENT_CONTEXT_WINDOW=32768  # the endpoint model's context length in tokens (default 128000)
# AGENT_REASONING=1           # the endpoint model thinks: AGENT_THINKING is sent to it

# Model downloads. Both can also be set in Settings → 模型下载 / Model downloads (Settings win).
# HF_ENDPOINT=https://hf-mirror.com   # Hugging Face mirror (the variable huggingface_hub uses)
# HF_TOKEN=hf_...                     # for gated models such as FLUX.2 [dev]
