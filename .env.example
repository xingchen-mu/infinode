# Copy to .env and adjust. Everything here is optional.

# Where ComfyUI is, as seen from this machine. Can also be changed in the app (设置).
COMFY_URL=http://127.0.0.1:8188

# Optional SSH tunnel for a ComfyUI that only listens on a remote server's localhost.
# `npm run dev` keeps `ssh -N -L <COMFY_URL port>:127.0.0.1:<REMOTE_COMFY_PORT> <SSH_HOST>` running.
# Use a host alias from ~/.ssh/config (key-based login). Leave empty for no tunnel.
SSH_HOST=
REMOTE_COMFY_PORT=8188

# Backend port, and the address it listens on (0.0.0.0 to use the canvas from other devices on your LAN).
PORT=8787
HOST=127.0.0.1
